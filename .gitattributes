# 行尾规则写进仓库，不再依赖每个人本地的 core.autocrlf 设置。
#
# text=auto  ——  仓库内一律存 LF，检出时转成各平台的本地行尾。
#                Windows 工作区仍然是 CRLF，不影响现有习惯。

* text=auto

# ---- 源码与配置（显式声明，顺便给 diff 更好的 hunk 标题）----
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.sln       text eol=crlf
*.json      text
*.jsonl     text
*.md        text
*.txt       text
*.py        text diff=python
*.xaml      text

# ---- 这些文件对行尾敏感，必须钉死 ----
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# ---- 二进制，禁止任何转换和 diff ----
*.pdf       binary
*.png       binary
*.jpg       binary
*.ico       binary
*.dll       binary
*.exe       binary
